{
  "name": "@each1024/pi-mini-mode",
  "version": "1.3.2",
  "description": "A compact Pi footer with live usage metrics, theme-aware settings previews, and configurable progress bars.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node test/footer-status-self-check.mjs && node test/settings-interaction.mjs && node test/transcript-adapter.mjs && node test/prompt-folding.mjs && node test/tool-folding.mjs && node test/sticky-tool.mjs && node test/minimal-markdown.mjs && node test/agent-view.mjs && node test/publish-self-check.mjs && node test/compaction-transcript.mjs"
  },
  "license": "MIT",
  "author": "eachann1024",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eachann1024/pi-mini-mode.git"
  },
  "bugs": {
    "url": "https://github.com/eachann1024/pi-mini-mode/issues"
  },
  "homepage": "https://github.com/eachann1024/pi-mini-mode#readme",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "footer",
    "tui"
  ],
  "pi": {
    "video": "https://raw.githubusercontent.com/eachann1024/pi-mini-mode/main/assets/mini-lens-settings.mp4",
    "extensions": [
      "./extensions/footer-status.ts"
    ],
    "themes": [
      "./themes/cc-dark.json",
      "./themes/cc-light.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "extensions",
    "lib",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@earendil-works/pi-tui": "^0.85.0",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "grok-mermaid": "0.2.2"
  }
}
